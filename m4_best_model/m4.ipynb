 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Milestone 4 — Best model & error analysis\n",
    "\n",
    "Same split, same target (`diagnosis_1`, 3 classes), same metric (macro-F1) as Milestones 2 and 3.\n",
    "\n",
    "1. ResNet-18 vs ViT-B/16, both frozen, same head (Session 9's fair comparison)\n",
    "2. The best model: pick on validation, use the test set once\n",
    "3. Error analysis\n",
    "4. Fairness check and the final scoreboard\n",
    "\n",
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 0. Setup"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "# PURPOSE: get my repo and the dataset into Colab (skip this cell on my laptop).\n",
    "# HOW: clone the repo, then the same download cell as Session 9.\n",
    "\n",
    "import os, urllib.request, zipfile\n",
    "from pathlib import Path\n",
    "\n",
    "!git clone -q https://github.com/sopipi180/ComputerVisionandSpeechRecognition.git\n",
    "%cd ComputerVisionandSpeechRecognition\n",
    "\n",
    "DEST = Path(\"/content/milk10k\")\n",
    "if not (DEST / \"metadata.csv\").exists():\n",
    "    urllib.request.urlretrieve(\n",
    "        \"https://isic-archive.s3.amazonaws.com/dois/10.34970-648456/milk10k.zip\",\n",
    "        \"/content/milk10k.zip\")\n",
    "    with zipfile.ZipFile(\"/content/milk10k.zip\") as z:\n",
    "        z.extractall(DEST)\n",
    "\n",
    "os.environ[\"MILK10K_DIR\"] = str(DEST)      # common/config.py reads this"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "# PURPOSE: libraries, my repo's config, and CPU or GPU.\n",
    "\n",
    "import sys\n",
    "import time\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "from PIL import Image\n",
    "from sklearn.metrics import f1_score, ConfusionMatrixDisplay\n",
    "from torchvision.models import resnet18, ResNet18_Weights, vit_b_16, ViT_B_16_Weights\n",
    "\n",
    "# My repo: walk up until common/config.py is found (as in Sessions 6 and 7)\n",
    "ROOT = next(p for p in [Path.cwd().resolve(), *Path.cwd().resolve().parents]\n",
    "            if (p / \"common\" / \"config.py\").is_file())\n",
    "sys.path.insert(0, str(ROOT))\n",
    "from common import config\n",
    "\n",
    "CACHE = ROOT / \"m4_best_model\" / \"_cache\"      # decoded images and features (not in git)\n",
    "CACHE.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
    "torch.manual_seed(config.SEED)\n",
    "print(device)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Data — my split, as in Milestones 2 and 3\n",
    "\n",
    "The split CSVs are grouped by lesion, so both photos of a lesion stay on the same side.\n",
    "One dermoscopic image per lesion, as in Sessions 5–7."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "# PURPOSE: load MY split and turn the labels into numbers.\n",
    "\n",
    "CLASSES = config.CLASSES_3                     # [\"Benign\", \"Indeterminate\", \"Malignant\"]\n",
    "\n",
    "splits = {}\n",
    "for name in [\"train\", \"val\", \"test\"]:\n",
    "    df = pd.read_csv(config.SPLIT_DIR / f\"{name}.csv\")\n",
    "    splits[name] = df[df[\"image_type\"].str.startswith(\"derm\")].reset_index(drop=True)\n",
    "\n",
    "y = {name: torch.tensor(df[\"diagnosis_1\"].map(CLASSES.index).to_numpy()) for name, df in splits.items()}\n",
    "\n",
    "for name, df in splits.items():\n",
    "    print(name, len(df), df[\"diagnosis_1\"].value_counts().to_dict())     # 3667 / 786 / 787"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "# PURPOSE: decode every image once at 224x224 and keep it (Session 7 / Session 9).\n",
    "# HOW: if the saved file exists, load it; if not, build it image by image and save it.\n",
    "\n",
    "def load_images(df, name):\n",
    "    f = CACHE / f\"images_{name}.pt\"\n",
    "    if not f.exists():\n",
    "        X = torch.stack([torch.from_numpy(np.array(Image.open(config.image_path(i)).convert(\"RGB\").resize((224, 224))))\n",
    "                         .permute(2, 0, 1) for i in df[\"isic_id\"]])          # (H,W,3) -> (3,H,W)\n",
    "        torch.save(X, f)\n",
    "    return torch.load(f)\n",
    "\n",
    "X = {name: load_images(df, name) for name, df in splits.items()}\n",
    "print({name: tuple(x.shape) for name, x in X.items()})"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "# PURPOSE: scale the pixels like ImageNet, because both networks learned on ImageNet (Session 7).\n",
    "# HOW: uint8 -> float in [0, 1] -> subtract the mean and divide by the std, per channel, on the GPU.\n",
    "\n",
    "MEAN = torch.tensor([0.485, 0.456, 0.406], device=device).view(1, 3, 1, 1)\n",
    "STD = torch.tensor([0.229, 0.224, 0.225], device=device).view(1, 3, 1, 1)\n",
    "\n",
    "def prep(xb):\n",
    "    return (xb.to(device).float() / 255 - MEAN) / STD"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. ResNet-18 vs ViT-B/16, a fair comparison\n",
    "\n",
    "Session 9's recipe: both backbones **frozen**, every lesion turned into one vector once\n",
    "(ResNet-18: 512 numbers, ViT: 768), then the **same** head trained on top.\n",
    "Only the backbone changes. This time on all 3,667 training lesions."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "# PURPOSE: turn every lesion into one vector per backbone (Session 9, run on the GPU).\n",
    "# HOW: remove each network's last layer, run all images once without gradients, save the result.\n",
    "\n",
    "def backbone(name):\n",
    "    if name == \"resnet18\":\n",
    "        net = resnet18(weights=ResNet18_Weights.IMAGENET1K_V1)\n",
    "        net.fc = nn.Identity()                    # output: 512 numbers instead of 1000 classes\n",
    "    else:\n",
    "        net = vit_b_16(weights=ViT_B_16_Weights.IMAGENET1K_V1)\n",
    "        net.heads = nn.Identity()                 # output: the class token, 768 numbers\n",
    "    return net.eval().to(device)\n",
    "\n",
    "def features(name, X, split):\n",
    "    f = CACHE / f\"features_{name}_{split}.pt\"\n",
    "    if not f.exists():\n",
    "        net, t0 = backbone(name), time.perf_counter()\n",
    "        with torch.no_grad():\n",
    "            out = torch.cat([net(prep(X[i:i + 64])).cpu() for i in range(0, len(X), 64)])\n",
    "        torch.save(out, f)\n",
    "        print(f\"{name} {split}: {tuple(out.shape)} in {time.perf_counter() - t0:.0f} s\")\n",
    "    return torch.load(f)\n",
    "\n",
    "feats = {name: {split: features(name, X[split], split) for split in [\"train\", \"val\", \"test\"]}\n",
    "         for name in [\"resnet18\", \"vit_b_16\"]}"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "# PURPOSE: the same head for both backbones (my Session 9 Exercise 4).\n",
    "\n",
    "def train_head(F_train, y, n_classes=3, epochs=25):\n",
    "    torch.manual_seed(0)\n",
    "    head = nn.Linear(F_train.shape[1], n_classes)                      # the only weights we train\n",
    "    class_weights = len(y) / (n_classes * torch.bincount(y, minlength=n_classes).float())\n",
    "    loss_fn = nn.CrossEntropyLoss(weight=class_weights)                # rare classes count more (Session 6)\n",
    "    optimizer = torch.optim.Adam(head.parameters(), lr=1e-3)\n",
    "    for epoch in range(epochs):\n",
    "        order = torch.randperm(len(y))                                 # new random order in each epoch\n",
    "        for i in range(0, len(y), 64):\n",
    "            idx = order[i:i + 64]                                      # one batch of 64 lesions\n",
    "            optimizer.zero_grad()\n",
    "            loss = loss_fn(head(F_train[idx]), y[idx])\n",
    "            loss.backward()\n",
    "            optimizer.step()\n",
    "    return head\n",
    "\n",
    "def macro_f1(head, F_, y):\n",
    "    with torch.no_grad():\n",
    "        pred = head(F_).argmax(1)\n",
    "    return f1_score(y, pred, average=\"macro\")"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "# PURPOSE: train both heads and score them on the same validation lesions. Test stays closed.\n",
    "\n",
    "heads, val_f1 = {}, {}\n",
    "for name in [\"resnet18\", \"vit_b_16\"]:\n",
    "    heads[name] = train_head(feats[name][\"train\"], y[\"train\"])\n",
    "    val_f1[name] = macro_f1(heads[name], feats[name][\"val\"], y[\"val\"])\n",
    "    print(f\"{name:9s} validation macro-F1 = {val_f1[name]:.3f}\")"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "# PURPOSE: where does each backbone make its mistakes? (Session 9, section 4.2)\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(10, 4))\n",
    "for ax, name in zip(axes, [\"resnet18\", \"vit_b_16\"]):\n",
    "    with torch.no_grad():\n",
    "        pred = heads[name](feats[name][\"val\"]).argmax(1)\n",
    "    ConfusionMatrixDisplay.from_predictions(y[\"val\"], pred, display_labels=CLASSES, cmap=\"Oranges\", ax=ax, colorbar=False)\n",
    "    ax.set_title(f\"{name}: macro-F1 {val_f1[name]:.3f}\")\n",
    "plt.tight_layout()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. The final round: both fine-tuned\n",
    "\n",
    "Session 7's recipe for both: unfreeze the **late** layers (they hold ImageNet-specific shapes) and keep\n",
    "the early ones frozen (edges, colours and textures transfer fine). 6 epochs, lr 1e-4, flips, and keep\n",
    "the best epoch on validation (early stopping).\n",
    "\n",
    "- **ResNet-18:** `layer3` + `layer4` + a new head (my Session 7 mini challenge, 0.642)\n",
    "- **ViT-B/16:** the last 2 of its 12 encoder blocks + a new head (the same idea for a transformer)"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "# PURPOSE: add variety to the training images without changing their labels (Session 7).\n",
    "# HOW: each image has a 50% chance of a left-right flip and, separately, of an up-down flip.\n",
    "\n",
    "def augment(xb):\n",
    "    n = xb.size(0)\n",
    "    flip_h = torch.rand(n, 1, 1, 1, device=xb.device) < 0.5\n",
    "    xb = torch.where(flip_h, xb.flip(3), xb)                 # left-right\n",
    "    flip_v = torch.rand(n, 1, 1, 1, device=xb.device) < 0.5\n",
    "    return torch.where(flip_v, xb.flip(2), xb)               # up-down"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "# PURPOSE: one function to predict and one to train (Session 7), used by both models.\n",
    "# HOW: Session 6's training step on batches of images. After each epoch, score on validation\n",
    "#      and remember the best weights; at the end, go back to them (early stopping).\n",
    "\n",
    "import copy\n",
    "\n",
    "class_weights = (len(y[\"train\"]) / (3 * torch.bincount(y[\"train\"]).float())).to(device)\n",
    "\n",
    "@torch.no_grad()\n",
    "def predict(model, X, batch_size=128):\n",
    "    model.eval()\n",
    "    return torch.cat([model(prep(X[i:i + batch_size])).argmax(1).cpu() for i in range(0, len(X), batch_size)])\n",
    "\n",
    "def fit(model, params, epochs, lr, batch_size=64):\n",
    "    model.to(device)\n",
    "    optimizer = torch.optim.Adam(params, lr=lr)              # params: only the weights we want to train\n",
    "    loss_fn = nn.CrossEntropyLoss(weight=class_weights)\n",
    "    best = {\"f1\": -1}\n",
    "    for epoch in range(epochs):\n",
    "        model.train()\n",
    "        order = torch.randperm(len(X[\"train\"]))              # new random order in each epoch\n",
    "        for i in range(0, len(X[\"train\"]), batch_size):\n",
    "            idx = order[i:i + batch_size]\n",
    "            xb, yb = augment(prep(X[\"train\"][idx])), y[\"train\"][idx].to(device)\n",
    "            optimizer.zero_grad()                            # forget the old gradients\n",
    "            loss = loss_fn(model(xb), yb)                    # forward + loss\n",
    "            loss.backward()                                  # backprop: compute the gradients\n",
    "            optimizer.step()                                 # update the weights\n",
    "        f1 = f1_score(y[\"val\"], predict(model, X[\"val\"]), average=\"macro\")\n",
    "        print(f\"epoch {epoch}  val macro-F1 {f1:.3f}\")\n",
    "        if f1 > best[\"f1\"]:\n",
    "            best = {\"f1\": f1, \"epoch\": epoch, \"state\": copy.deepcopy(model.state_dict())}\n",
    "    model.load_state_dict(best[\"state\"])                     # early stopping: keep the best epoch\n",
    "    return best"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "# PURPOSE: ResNet-18 with layer3 + layer4 + a new head trainable (my Session 7 mini challenge).\n",
    "\n",
    "torch.manual_seed(0)\n",
    "resnet = resnet18(weights=ResNet18_Weights.IMAGENET1K_V1)\n",
    "resnet.fc = nn.Linear(512, 3)                                # new head: 3 classes\n",
    "for name, p in resnet.named_parameters():\n",
    "    p.requires_grad = name.startswith((\"layer3\", \"layer4\", \"fc\"))\n",
    "\n",
    "trainable = [p for p in resnet.parameters() if p.requires_grad]\n",
    "print(f\"training {sum(p.numel() for p in trainable):,} of {sum(p.numel() for p in resnet.parameters()):,} weights\")\n",
    "best_resnet = fit(resnet, trainable, epochs=6, lr=1e-4)"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "# PURPOSE: the same idea for ViT-B/16: its last 2 encoder blocks + a new head trainable.\n",
    "# HOW: a weight's name says where it sits, e.g. \"encoder.layers.encoder_layer_11.mlp.0.weight\".\n",
    "#      \"encoder.ln\" is the normalisation right after the last block, so it trains with them.\n",
    "\n",
    "torch.manual_seed(0)\n",
    "vit = vit_b_16(weights=ViT_B_16_Weights.IMAGENET1K_V1)\n",
    "vit.heads = nn.Linear(768, 3)                                # new head: 3 classes\n",
    "for name, p in vit.named_parameters():\n",
    "    p.requires_grad = name.startswith((\"encoder.layers.encoder_layer_10\", \"encoder.layers.encoder_layer_11\",\n",
    "                                       \"encoder.ln\", \"heads\"))\n",
    "\n",
    "trainable = [p for p in vit.parameters() if p.requires_grad]\n",
    "print(f\"training {sum(p.numel() for p in trainable):,} of {sum(p.numel() for p in vit.parameters()):,} weights\")\n",
    "best_vit = fit(vit, trainable, epochs=6, lr=1e-4)"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "# PURPOSE: choose the final model on VALIDATION only. The test set is still closed.\n",
    "\n",
    "if best_vit[\"f1\"] > best_resnet[\"f1\"]:\n",
    "    best_name, model = \"ViT-B/16 fine-tuned\", vit\n",
    "else:\n",
    "    best_name, model = \"ResNet-18 fine-tuned\", resnet\n",
    "print(f\"ResNet-18 fine-tuned {best_resnet['f1']:.3f} | ViT-B/16 fine-tuned {best_vit['f1']:.3f}\")\n",
    "print(\"final model:\", best_name)"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "# PURPOSE: open the test set ONCE, now that the choice is made, and score every M4 model for the scoreboard.\n",
    "\n",
    "test_pred = {\"ResNet-18 fine-tuned\": predict(resnet, X[\"test\"]),\n",
    "             \"ViT-B/16 fine-tuned\": predict(vit, X[\"test\"])}\n",
    "\n",
    "m4 = pd.DataFrame([\n",
    "    {\"model\": \"ResNet-18 frozen + head\", \"val\": val_f1[\"resnet18\"],\n",
    "     \"test\": macro_f1(heads[\"resnet18\"], feats[\"resnet18\"][\"test\"], y[\"test\"])},\n",
    "    {\"model\": \"ViT-B/16 frozen + head\", \"val\": val_f1[\"vit_b_16\"],\n",
    "     \"test\": macro_f1(heads[\"vit_b_16\"], feats[\"vit_b_16\"][\"test\"], y[\"test\"])},\n",
    "    {\"model\": \"ResNet-18 fine-tuned\", \"val\": best_resnet[\"f1\"],\n",
    "     \"test\": f1_score(y[\"test\"], test_pred[\"ResNet-18 fine-tuned\"], average=\"macro\")},\n",
    "    {\"model\": \"ViT-B/16 fine-tuned\", \"val\": best_vit[\"f1\"],\n",
    "     \"test\": f1_score(y[\"test\"], test_pred[\"ViT-B/16 fine-tuned\"], average=\"macro\")},\n",
    "]).round(3)\n",
    "m4"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "# PURPOSE: save the M4 deliverables: the final model and its predictions on my test split.\n",
    "\n",
    "torch.save(model.state_dict(), ROOT / \"m4_best_model\" / \"model_m4.pt\")\n",
    "\n",
    "out = splits[\"test\"][[\"isic_id\", \"lesion_id\", \"diagnosis_1\"]].copy()\n",
    "out[\"predicted\"] = [CLASSES[i] for i in test_pred[best_name]]\n",
    "out.to_csv(ROOT / \"m4_best_model\" / \"test_predictions.csv\", index=False)\n",
    "print(out[\"predicted\"].value_counts().to_dict())"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "# Colab only: download both files, then put them in m4_best_model \n",
    "from google.colab import files\n",
    "files.download(str(ROOT / \"m4_best_model\" / \"model_m4.pt\"))\n",
    "files.download(str(ROOT / \"m4_best_model\" / \"test_predictions.csv\"))"
   ]
  }
 ],
